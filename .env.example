# ==============================================================================
# HANDĀ - VARIABILI DI AMBIENTE
# Copia questo file in .env.local (per sviluppo locale) e inserisci le stesse
# chiavi nella dashboard di Vercel (Project Settings -> Environment Variables)
# ==============================================================================

# 1. DATABASE SUPABASE (Obbligatorio per persistenza cloud)
# Trova queste chiavi in Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tua-service-role-key-segreta
# In alternativa al service role puoi usare l'anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=tua-anon-public-key

# 2. NOTIFICHE TELEGRAM PER LO STAFF (Consigliatissimo per avvisi istantanei)
# Crea un bot con @BotFather su Telegram e ottieni il token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Ottieni l'ID del gruppo dello staff aggiungendo @userinfobot o @RawDataBot nel gruppo
TELEGRAM_CHAT_ID=-1001234567890

# 3. NOTIFICHE EMAIL (Opzionale, via Resend)
# Registrati gratis su resend.com per ottenere la chiave
RESEND_API_KEY=re_123456789abcdef
NOTIFICATION_EMAIL=info@handa-izakaya.it
